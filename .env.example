# Copy to .env and fill in. NEVER commit the real .env file.

# --- Database ---
DB_USERNAME=dairy_app
DB_PASSWORD=change-me-to-a-long-random-password

# --- Security ---
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Token lifetime in minutes (720 = 12 hours, i.e. one shift)
JWT_EXPIRATION_MINUTES=720

# --- First owner account (only used when the database has no owner yet) ---
# After the first start, remove BOOTSTRAP_OWNER_PASSWORD and change the password from the app.
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Owner

# --- Optional ---
# Web frontend origins allowed to call the API (comma separated). Not needed for mobile apps.
CORS_ALLOWED_ORIGINS=
APP_TIMEZONE=Asia/Kolkata
# Set to "native" when running behind nginx / a load balancer.
FORWARD_HEADERS_STRATEGY=none
